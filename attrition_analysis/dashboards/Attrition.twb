      <aliases enabled='yes' />
      <column caption='Age (bin)' datatype='integer' name='[Age (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[age]' peg='0' size='10' />
      </column>
      <column caption='Headcount' datatype='integer' name='[Calculation_1973932782256128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([employee_id])' />
      </column>
      <column caption='Attrition Rate' datatype='real' default-format='p0.0%' name='[Calculation_1973932782338049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([is_attrition])) / COUNT([employee_id])' />
      </column>
      <column caption='Attrition Status' datatype='string' name='[Calculation_1973932792340483]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_attrition] = 1 THEN &quot;Left&quot;&#10;ELSE &quot;Stayed&quot;&#10;END' />
      </column>
      <column caption='Jitter' datatype='real' name='[Calculation_1973932797374471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANDOM()' />
      </column>
      <column caption='Age Groups' datatype='string' name='[Calculation_1973932871745545]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 25 THEN &quot;Under 25&quot;&#10;ELSEIF [age] &lt;= 35 THEN &quot;26 to 35&quot;&#10;ELSEIF [age] &lt;= 45 THEN &quot;36 to 45&quot;&#10;ELSEIF [age] &lt;= 55 THEN &quot;46 to 55&quot;&#10;ELSE &quot;56 and up&quot;&#10;END' />
      </column>
      <column caption='Gender Groups' datatype='string' name='[Calculation_1973932873129994]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([gender] = &quot;Male&quot; OR [gender] = &quot;Null&quot;)&#10;THEN &quot;Male&quot;&#10;ELSE &quot;Not Male&quot;&#10;END' />
      </column>
      <column caption='Audit Category' datatype='string' name='[Calculation_1973932879785996]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [flight_risk_flag] = 1 AND [is_attrition] = 1 THEN &quot;True Positive&quot;&#10;ELSEIF [flight_risk_flag] = 1 AND [is_attrition] = 0 THEN &quot;False Positive&quot;&#10;ELSEIF [flight_risk_flag] = 0 AND [is_attrition] = 1 THEN &quot;False Negative&quot;&#10;ELSE &quot;True Negative&quot;&#10;END' />
      </column>
      <column caption='Attrition per tenure' datatype='real' default-format='p0.0%' name='[Calculation_1973932886155278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_attrition] = 1 THEN 1 ELSE 0 END) / COUNT([employee_id])' />
      </column>
      <column aggregation='None' caption='Comp Ratio (bin)' datatype='integer' name='[Comp Ratio (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='-1' formula='[comp_ratio]' peg='0' size='0.1' />
      </column>
